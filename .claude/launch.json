{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openbb-api",
      "runtimeExecutable": "envs/openbb/bin/openbb-api",
      "runtimeArgs": [
        "--host",
        "127.0.0.1",
        "--port",
        "6900"
      ],
      "port": 6900
    },
    {
      "name": "openbb-backend",
      "cwd": "openbb-backend",
      "runtimeExecutable": "../envs/finrl/bin/uvicorn",
      "runtimeArgs": [
        "main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "openbb-mcp",
      "runtimeExecutable": "envs/openbb/bin/openbb-mcp",
      "runtimeArgs": [
        "--host",
        "127.0.0.1",
        "--port",
        "8005",
        "--allowed-categories",
        "equity,news,index",
        "--default-categories",
        "equity,news,index"
      ],
      "port": 8005
    },
    {
      "name": "agent",
      "cwd": "agent",
      "runtimeExecutable": "../envs/fingpt/bin/uvicorn",
      "runtimeArgs": [
        "main:app",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "ui-dev",
      "cwd": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
